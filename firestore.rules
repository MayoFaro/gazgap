rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Exactement deux comptes, droits identiques (pilote + administrateur/
    // technique) : pas de matrice de droits, juste ces deux UID.
    // - Admin (groodep@yahoo.fr) : uid réel.
    // - Pilote : pas encore créé — tant que 'REMPLACER_PAR_UID_PILOTE'
    //   subsiste ci-dessous, ce placeholder ne correspond à aucun compte
    //   réel et ne match donc jamais ; remplacer dès que le compte pilote
    //   existe (même procédure : scripts/bootstrap-user.js).
    function isPiloteOuAdmin() {
      return request.auth != null &&
        request.auth.uid in [
          'REMPLACER_PAR_UID_PILOTE',
          '984RJIjYFdh7qIRFKlPH0heWTnD3'
        ];
    }

    match /flights/{id} {
      allow read, write: if isPiloteOuAdmin();
    }

    // Tout le reste : refusé (pas de users/profiles/aircraft/settings).
    match /{document=**} { allow read, write: if false; }
  }
}
